{
  "name": "3rcgo-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file=.env dist/server.js",
    "dev": "node --env-file=.env --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "smtp:check": "node --env-file=.env --import tsx src/smtp-check.ts"
  },
  "dependencies": {
    "nodemailer": "10.0.15"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}